# Copy to .env on the box: cp .env.example .env
#
# Three values. The first two also exist in the Vercel project and one of them
# has to match exactly; the third is what the certificate is issued for.

# Neon → your project → Connection string → **Direct** (not pooled).
# The same value the GitHub Actions secret used.
DATABASE_URL=

# Shared secret between the Next app and this worker. The worker's endpoints
# re-sync any member's history and crawl Kattis, so reaching the URL must not
# be the same thing as being allowed to use it.
#
# Generate one:  openssl rand -hex 32
# Then set the *identical* value as WORKER_TOKEN in the Vercel project.
WORKER_TOKEN=

# The hostname this box answers on, e.g. cp-worker.example.com — or a free
# subdomain (DuckDNS and similar work fine with Let's Encrypt). Its DNS A
# record must already point at the VM's public IP before you start Caddy,
# because the certificate is issued over HTTP to that name.
#
# This is also what goes in Vercel as WORKER_URL, with https:// in front.
WORKER_DOMAIN=

# How often the passive mirror runs. Note the loop sleeps *first*, so the
# first pass after a restart is one interval away — linking a handle syncs
# immediately regardless, which is the path that matters for onboarding.
SYNC_INTERVAL_MINUTES=30
