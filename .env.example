# Copy to `.env`. Both the Next app and the Python worker read these (defaults
# shown work with the Docker Postgres from `pnpm db`).
DATABASE_URL=postgresql://cp:cp@localhost:5488/cp_trainer

# Where the Next app reaches the worker.
WORKER_URL=http://localhost:8787

# Worker: minutes between passive full-history syncs.
SYNC_INTERVAL_MINUTES=30

# GitHub OAuth, for sign-in and club groups. Register an app at
# https://github.com/settings/developers with the callback URL
#   http://localhost:3000/api/auth/callback
# In production it's the same path on your real origin — the redirect URI is
# derived from the incoming request, so there is nothing else to configure.
#
# Leave BOTH unset for a solo install: `next dev` then offers "Continue as
# local user", which signs you into the account holding your mirrored
# Codeforces history. That fallback 404s in production and disappears the
# moment these are filled in — so set them before you share an invite code.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
