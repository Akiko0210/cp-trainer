# Copy to `.env`. Both the Next app and the Python worker read these (defaults
# shown work with the Docker Postgres from `pnpm db`).
DATABASE_URL=postgresql://cp:cp@localhost:5488/cp_trainer

# Where the Next app reaches the worker.
WORKER_URL=http://localhost:8787

# Worker: minutes between passive full-history syncs.
SYNC_INTERVAL_MINUTES=30

# GitHub OAuth, for sign-in and the guild. Register an app at
# https://github.com/settings/developers with the callback URL
#   http://localhost:3000/api/auth/callback
# and, for a deployment, a second app whose callback is the same path on your
# real origin.
#
# Leave BOTH unset for a solo install: `next dev` then offers "Continue as
# local user", which signs you into the account holding your mirrored
# Codeforces history. That fallback 404s in production and disappears the
# moment these are filled in — so set them before you share an invite code.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Deployment only. See DEPLOY.md. The app refuses to boot in production
# without DATABASE_URL, both GITHUB_* values, and WORKER_TOKEN — a half
# configured deploy should fail loudly at startup, not quietly at sign-in.
# ---------------------------------------------------------------------------

# Managed Postgres gives you two connection strings. Ordinary queries use the
# pooled one (DATABASE_URL above); the live leaderboard needs the direct one,
# because LISTEN cannot survive a transaction pooler — the connection you
# registered the listener on is handed to someone else between statements and
# the notifications silently never arrive. Leave unset on a single Postgres.
DATABASE_URL_UNPOOLED=

# Shared secret between the app and the worker. The worker can re-sync any
# member's history and crawl Kattis, so reaching its URL must not be the same
# thing as being allowed to drive it. Generate with:
#   openssl rand -base64 32
WORKER_TOKEN=

# Your public origin, e.g. https://cp.example.com. Only needed when the app
# sits behind something that doesn't set x-forwarded-proto/host; otherwise the
# OAuth callback is derived from the request.
PUBLIC_ORIGIN=

# Comma-separated GitHub logins allowed to run operator actions (re-crawling
# the Kattis archive). Unset means "the first account on the install".
ADMIN_GITHUB_LOGINS=

# docker-compose only.
DOMAIN=
POSTGRES_PASSWORD=
